@using CubanSox.Web.Models
@inject NavigationManager Navigation

<MudDialog Class="leader-dialog-container">
    <TitleContent>
        <div class="header-toolbar">
            <MudText Typo="Typo.h6" Class="title-text">
                Detalles del Liderato
            </MudText>

            <div class="d-flex align-center gap-1">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.BarChart"
                           OnClick="VerRankingCompleto"
                           Class="ranking-btn">
                    <span class="btn-text">Ver ranking completo</span>
                    <span class="btn-text-mobile">Ranking</span>
                </MudButton>
                <!-- Único botón blanco -->
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               OnClick="() => MudDialog.Cancel()"
                               Class="close-icon-white" />
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="leader-board-wrapper">
            <div class="leader-header">
                <div class="header-main">@CategoryCode</div>
                <div class="header-sub">LIDERATO</div>
            </div>

            <div class="main-content-flex">
                <div class="players-list">
                    @for (int i = 0; i < Leaders.Count; i++)
                    {
                        var item = Leaders[i];
                        <div class="player-row @(i < 3 ? "is-top-three" : "")">
                            <div class="rank-section">
                                <span class="rank-hash">#</span>@item.DisplayRank
                            </div>
                            <div class="team-logo">
                                <img src="@item.TeamLogo" alt="team" />
                            </div>
                            <div class="name-section">
                                <div class="player-full-name">@item.Name.ToUpper()</div>
                            </div>
                            <div class="value-section">
                                @((int)item.Value)
                            </div>
                        </div>
                    }
                </div>

                <div class="top-photos-column">
                    @foreach (var top in Leaders.Take(3))
                    {
                        <div class="photo-box">
                            <img src="@top.Photo" onerror="this.src='/images/default-player.png'" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

<style>
    /* CONTENEDOR PRINCIPAL - Centrado con márgenes uniformes */
    .leader-dialog-container {
        background-color: var(--mud-palette-primary) !important;
        max-width: 850px;
        --row-height: 46px;
        --total-list-height: calc((var(--row-height) * 10) + (2px * 9));
        border-radius: 12px !important;
        margin: 16px auto !important; /* Margen uniforme arriba/abajo y centrado lateral */
    }

        /* ENCABEZADO DIFERENCIADO */
        .leader-dialog-container .mud-dialog-title {
            padding: 10px 16px !important;
            background-color: rgba(0,0,0,0.2) !important;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

    .header-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        color: white !important;
    }

    .title-text {
        color: white !important;
        font-weight: bold;
        font-size: 1rem;
    }

    .close-icon-white {
        color: white !important;
    }

    .ranking-btn {
        color: white !important;
        border-color: rgba(255,255,255,0.5) !important;
        text-transform: none;
        font-size: 0.8rem;
    }

        .ranking-btn .mud-button-icon-start {
            color: white !important;
        }

    .btn-text-mobile {
        display: none;
    }

    /* CUERPO */
    .leader-board-wrapper {
        color: white;
        font-family: 'Roboto Condensed', sans-serif;
        padding: 10px;
    }

    .leader-header {
        background-color: white;
        color: var(--mud-palette-primary);
        width: 120px;
        text-align: center;
        padding: 4px;
        margin-bottom: 12px;
        clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);
    }

    .header-main {
        font-size: 1.8rem;
        font-weight: 900;
        line-height: 1;
    }

    .header-sub {
        background-color: #d32f2f;
        color: white;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .main-content-flex {
        display: flex;
        gap: 8px;
        align-items: stretch;
    }

    .players-list {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow: hidden;
    }

    .player-row {
        display: flex;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.25);
        height: var(--row-height);
        padding: 0 12px;
        border-radius: 6px;
    }

    .is-top-three {
        background-color: #d32f2f;
    }

    .rank-section {
        width: 35px;
        font-weight: 900;
    }

    .team-logo img {
        width: 28px;
        height: 28px;
        margin-right: 8px;
        border-radius: 50%;
        background: white;
        padding: 2px;
    }

    .name-section {
        flex: 1;
        min-width: 0;
    }
    /* min-width: 0 es clave para el truncado de texto */
    .player-full-name {
        font-weight: 700;
        font-size: 0.95rem;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .value-section {
        font-size: 1.5rem;
        font-weight: 900;
        width: 50px;
        text-align: right;
    }

    .top-photos-column {
        width: 260px;
        height: var(--total-list-height);
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .photo-box {
        flex: 1;
        overflow: hidden;
        border-radius: 8px;
        border: 2px solid rgba(255,255,255,0.2);
    }

        .photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* =======================================================
           AJUSTES MÓVIL: Uniformidad y Ajuste de Contenido
           ======================================================= */
    @@media (max-width: 600px) {
        .leader-dialog-container {
            width: 92% !important; /* Ocupa el 92% centrado */
            max-width: 92% !important;
            margin: 10px auto !important; /* Márgenes laterales iguales */
        }

        .btn-text {
            display: none;
        }

        .btn-text-mobile {
            display: inline;
        }

        .top-photos-column {
            display: none;
        }
        /* Ajuste de anchos internos para eliminar el scroll */
        .player-row {
            padding: 0 8px;
        }

        .rank-section {
            width: 25px;
            font-size: 0.85rem;
        }

        .team-logo img {
            width: 24px;
            height: 24px;
            margin-right: 5px;
        }

        .player-full-name {
            font-size: 0.8rem;
        }

        .value-section {
            width: 40px;
            font-size: 1.2rem;
        }
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public List<LeaderDetailDTO> Leaders { get; set; }
    [Parameter] public string CategoryCode { get; set; }

    private void VerRankingCompleto()
    {
        string sortField = CategoryCode == "DB" ? "HBP" : CategoryCode;
        Navigation.NavigateTo($"/stats?sort={sortField}");
        MudDialog.Close();
    }
}